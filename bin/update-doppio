#!/usr/bin/env bash
# Regenerate Formula/doppio.rb from the latest stable angelocordon/doppio release.
set -euo pipefail
cd "$(dirname "$0")/.."

repo=angelocordon/doppio
tag=$(gh release view --repo "$repo" --json tagName --jq .tagName)
version=${tag#v}
sums=$(gh release download "$tag" --repo "$repo" --pattern SHA256SUMS --output -)
sha() { awk -v f="doppio-darwin-$1.tar.gz" '$2 == f { print $1 }' <<<"$sums"; }
arm64=$(sha arm64)
x64=$(sha x64)
[ -n "$arm64" ] && [ -n "$x64" ] || { echo "missing checksums for $tag" >&2; exit 1; }
base="https://github.com/$repo/releases/download/$tag"

cat > Formula/doppio.rb <<RUBY
# Generated by bin/update-doppio; edit that script instead.
class Doppio < Formula
  desc "Keep your Mac awake for a set time, with a live countdown"
  homepage "https://github.com/$repo"
  version "$version"
  license "MIT"

  depends_on :macos

  on_arm do
    url "$base/doppio-darwin-arm64.tar.gz"
    sha256 "$arm64"
  end

  on_intel do
    url "$base/doppio-darwin-x64.tar.gz"
    sha256 "$x64"
  end

  def install
    bin.install "doppio"
    bin.install_symlink "doppio" => "dop"
  end

  test do
    assert_match "doppio #{version}", shell_output("#{bin}/dop --version")
  end
end
RUBY
echo "doppio $version"
